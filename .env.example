# Copy-Item .env.example .env; enter your own key only in .env.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.1-flash-lite
# Actual free-tier limit observed: 15 requests/minute.
GEMINI_REQUEST_INTERVAL=4.5
# FP32 is faster on this CPU; use float16 if memory is constrained.
RERANKER_DTYPE=float32
